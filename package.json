{
  "name": "bharata-online",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n srv,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "npm run build && NODE_ENV=production node --import tsx server/index.ts",
    "serve": "node --import tsx server/index.ts",
    "sim": "tsx scripts/simulate.ts",
    "sim:variants": "tsx scripts/simulate-variants.ts",
    "sim:invariants": "tsx scripts/playtest/invariants.ts",
    "sim:logic4p": "tsx scripts/playtest/logic-4p.ts",
    "e2e": "tsx scripts/e2e-socket.ts",
    "test:ui": "playwright test --config e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "perf": "node scripts/perf.mjs",
    "artifacts": "tsx scripts/artifacts.ts",
    "demo": "tsx scripts/demo.ts",
    "sim:battles": "tsx scripts/playtest/battle-history.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.1"
  }
}
